# Response headers for the Cloudflare Pages deployment of the Canvas docs.
#
# Cloudflare applies every rule whose path matches, so the `/*` block below is the
# baseline for the whole site and the narrower blocks add caching on top of it.
# Anything in docs/public is copied verbatim into the export, so this file ships as
# part of `expo export -p web` with no build step of its own.

/*
  # A strict Content-Security-Policy. `script-src 'self'` with no 'unsafe-inline' and
  # no 'unsafe-eval' is possible because the Expo web export emits ZERO inline scripts
  # (one external bundle, verified against the built index.html) and because the two
  # eval() sites in that bundle are unreachable in a browser: one is a Node fallback
  # guarded by `typeof window`, the other is Metro's split-bundle loader, which never
  # runs in a single-bundle SPA export.
  #
  # `style-src` DOES need 'unsafe-inline'. React Native Web writes dynamic styles as
  # inline style attributes (a heading arrives as style="font-family: Geist_600SemiBold;
  # font-size: 54px"), so removing it would strip the site's typography and colour. This
  # is the accepted trade: CSP's XSS protection lives in script-src, which stays strict.
  #
  # `connect-src` names registry.npmjs.org because the version badge fetches the current
  # published version at runtime. It is the only cross-origin request the app makes; the
  # other external hosts in the bundle are link targets, not fetches.
  #
  # `require-trusted-types-for 'script'` is enabled deliberately, not optimistically. The
  # bundle contains 5 innerHTML assignments and 14 dangerouslySetInnerHTML sites, any of
  # which would throw under Trusted Types, so it was verified before shipping: all 81
  # routes (12 nav pages + 69 component pages) were loaded with this exact policy applied
  # and reported zero violations and zero console errors. All 5 and all 14 are dependency
  # code on paths this app never takes (React's dangerouslySetInnerHTML and <script>
  # branches, expo-clipboard's HTML reader, a legacy styleSheet.cssText branch); no Canvas
  # or docs component uses dangerouslySetInnerHTML.
  #
  # The danger this policy actually caught was OUR OWN code, not a dependency. The web
  # glass lens shipped injecting its SVG filter defs with `innerHTML`, at module-import
  # time, so the TypeError escaped the module factory before React ever mounted and the
  # whole site served a blank page. Two guards now stand behind this header: kit source is
  # linted against every Trusted Types sink (no-restricted-syntax in eslint.config.mjs),
  # and test/glass-lens.test.tsx drives both def-injection paths through a setter that
  # throws exactly as Chromium does. Re-run the route sweep anyway whenever a dependency
  # that touches the DOM is added or upgraded, and note that a violation on an import path
  # is fatal to the entire app rather than merely to one effect.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://registry.npmjs.org; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; upgrade-insecure-requests

  # One year, covering this host and anything below it. `includeSubDomains` is scoped to
  # *.canvas.nannier.com and cannot affect nannier.com or its siblings, and no such
  # subdomain exists today, so it costs nothing. The `preload` token only declares
  # eligibility: actually preloading requires a separate submission at hstspreload.org,
  # which is the site owner's call because it is slow to reverse.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Sever the opener relationship for anything this site opens or is opened by. The docs
  # link out to GitHub and npm with target=_blank, so this also removes reverse-tabnabbing.
  # Note this is COOP alone: COEP is deliberately absent, since require-corp would block
  # the registry.npmjs.org fetch above, which serves no CORP header.
  Cross-Origin-Opener-Policy: same-origin

  # Clickjacking is already refused by `frame-ancestors 'none'` in the CSP; this repeats it
  # in the older header for user agents that predate frame-ancestors support.
  X-Frame-Options: DENY

  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # Refuse every powerful browser feature this site does not use, so a script that got in
  # anyway still could not reach a camera, a microphone, location, or a USB/serial device.
  # clipboard-write is the one capability deliberately kept, scoped to same-origin: the
  # docs' copy-code buttons go through expo-clipboard, which uses navigator.clipboard.
  # fullscreen is simply absent, which leaves it at its same-origin default.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), clipboard-write=(self)

  # Stop other origins pulling these bytes into their own pages. The site is one origin and
  # loads nothing from anywhere else, so nothing legitimate is lost. Social previews are
  # unaffected: crawlers fetch og.png server-side, where CORP is not enforced.
  Cross-Origin-Resource-Policy: same-origin

  # Cloudflare Pages sends `Access-Control-Allow-Origin: *` by default, which invites any
  # origin to read these responses. Nothing here needs it: every request is same-origin, and
  # same-origin requests skip the CORS check entirely, including the crossorigin font
  # preloads above (confirmed by serving the whole site locally with no such header and
  # watching all eight faces still load).
  ! Access-Control-Allow-Origin

# Every file under these two prefixes carries a 32-character content hash in its name
# (verified: 405 of 405), so its URL changes whenever its bytes do and it can never go
# stale. Cloudflare's default of `max-age=0, must-revalidate` was making every repeat
# visitor pay a revalidation round-trip for the 736 KiB bundle and all eight font files
# even when nothing had changed. `immutable` also stops a reload from revalidating them.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
