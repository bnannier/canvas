  "scripts": {
    "postinstall": "node scripts/link-sources.mjs && bun run --cwd ../packages/canvas-blur build",
    "dev": "node scripts/dev.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/inline-css.mjs dist && node scripts/prepare-pages.mjs dist && node scripts/paint-first.mjs dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:nav": "bun scripts/check-nav-sync.ts",
    "check:skins": "bun scripts/check-platform-skins.ts",
    "check:patches": "bun scripts/check-patches.ts",
    "lighthouse": "bun scripts/lighthouse.ts",
    "eas-build-pre-install": "bun install --cwd .. --frozen-lockfile",
    "fonts:subset": "node scripts/subset-fonts.mjs"
  },
  "patchedDependencies": {
    "expo-modules-jsi@57.0.5": "patches/expo-modules-jsi@57.0.5.patch",
    "@expo/router-server@57.0.7": "patches/@expo%2Frouter-server@57.0.7.patch",
    "expo@57.0.16": "patches/expo@57.0.16.patch",
    "@expo/cli@57.0.18": "patches/@expo%2Fcli@57.0.18.patch",
    "expo-router@57.0.16": "patches/expo-router@57.0.16.patch"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../packages"
