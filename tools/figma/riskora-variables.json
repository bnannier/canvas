  "mapping": {
    "comment": "How the kit's semantic tokens (src/style/tokens.ts, authored as oklch in styles/tokens/colors.css) derive from the source variables. `tolerance` is the per-channel sRGB slack the oklch re-authoring on one neutral hue may introduce; `solved` records a deliberate deviation and why. scripts/check-figma-parity.ts fails when a mapped token drifts, or when a token is neither mapped nor explained.",
    "tokens": {
      "background": { "variable": "bg/weak-50", "tolerance": 3, "note": "re-authored on the 262 neutral hue" },
      "foreground": { "variable": "text/strong-950", "tolerance": 1 },
      "card": { "variable": "bg/white-0", "tolerance": 2 },
      "card-foreground": { "variable": "text/strong-950", "tolerance": 1 },
      "popover": { "variable": "bg/white-0", "tolerance": 2 },
      "popover-foreground": { "variable": "text/strong-950", "tolerance": 1 },
      "primary": { "variable": "sky/400", "tolerance": 0 },
      "primary-foreground": { "variable": "text/strong-950", "mode": "light", "tolerance": 1, "note": "the light-mode ink on sky in BOTH schemes (text/white-0 dark is the same value): the source's own dark-mode label; white-on-sky is 2.7:1" },
      "secondary": { "variable": "bg/soft-200", "tolerance": 1 },
      "secondary-foreground": { "variable": "text/strong-950", "tolerance": 1 },
      "muted": { "variable": "bg/soft-200", "tolerance": 1 },
      "muted-foreground": { "variable": "text/sub-600", "tolerance": 2 },
      "accent": { "variable": "bg/soft-200", "tolerance": 1 },
      "accent-foreground": { "variable": "text/strong-950", "tolerance": 1 },
      "destructive": {
        "light": { "variable": "red/700", "tolerance": 0 },
        "dark": { "solved": "state/error/base dark (#e93544) is 4.15:1 with white text; deepened until white clears 4.5:1" }
      },
      "destructive-foreground": { "variable": "static/static-white", "tolerance": 0 },
      "destructive-text": { "solved": "the error text role on neutral surfaces is solved to 4.5:1 through the pressed-surface neighborhood the contrast tests model; no source variable is a text-on-neutral red" },
      "success": {
        "light": { "variable": "green/800", "tolerance": 1 },
        "dark": { "solved": "the source paints dark success with a green dot icon and no fill variable; a lighter green that carries the dark success-foreground" }
      },
      "success-foreground": { "solved": "the source has no on-success text variable; white on green/800 (light), the kit's dark green on the dark fill" },
      "warning": {
        "light": { "variable": "orange/800", "tolerance": 1 },
        "dark": { "variable": "orange/400", "tolerance": 0 }
      },
      "warning-foreground": { "solved": "the source has no on-warning text variable; white on orange/800, the kit's dark brown on orange/400" },
      "border": {
        "light": { "variable": "stroke/soft-200", "tolerance": 1 },
        "dark": { "solved": "stroke/soft-200 dark is a 28% alpha of #2b303b; the kit carries opaque tokens, so this is that alpha composited over the card and lifted a step so it reads on the page too" }
      },
      "input": { "solved": "WCAG 1.4.11: the control boundary must clear 3:1 on the page, a card and a muted panel; the source's field border (stroke/sub-300, 1.7:1) does not, so the value is the lightest one on the neutral hue that does" },
      "ring": { "variable": "sky/400", "mode": "light", "tolerance": 0, "note": "one value in both schemes" },
      "primary-text": {
        "light": { "solved": "sky/400 is 2.7:1 on white; the same hue deepened until link text clears 4.5:1 on the page, a card and a muted panel" },
        "dark": { "variable": "sky/400", "tolerance": 0 }
      },
      "chart-1": { "variable": "sky/400", "mode": "light", "tolerance": 0 },
      "chart-2": { "solved": "orange/400 is the dark warning fill and the series palette may not reuse a status token; the bar highlight orange shifted one step" },
      "chart-3": { "solved": "series green, distinct from the success fills" },
      "chart-4": { "variable": "blue/300", "mode": "light", "tolerance": 0 },
      "chart-5": { "solved": "series amber" },
      "chart-6": { "solved": "series teal" },
      "chart-7": { "solved": "series pink" },
      "chart-8": { "solved": "series violet" }
    },
