{
  "name": "@olympusoss/canvas",
  "version": "6.23.2",
  "description": "Universal React Native UI kit styled with Tailwind",
  "license": "UNLICENSED",
  "homepage": "https://olympusoss.github.io/canvas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlympusOSS/canvas.git"
  },
  "bugs": {
    "url": "https://github.com/OlympusOSS/canvas/issues"
  },
  "keywords": [
    "react-native",
    "react-native-web",
    "ui-kit",
    "component-library",
    "design-system",
    "ios",
    "android",
    "web",
    "universal",
    "cross-platform",
    "liquid-glass",
    "accessibility",
    "tailwind",
    "expo"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "verify-package": "bun scripts/verify-package.ts",
    "prepublishOnly": "bun run build && bun run verify-package",
    "test": "bun test",
    "validate-tokens": "bun scripts/validate-tokens.ts",
    "check-size": "bun scripts/check-size.ts",
    "check-duplicates": "bun scripts/check-duplicates.ts",
    "screenshots": "bun scripts/capture-screenshots.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "docs:gen": "bun tools/docgen/generate.ts",
    "icons:gen": "bun tools/icongen/generate.ts",
    "docs:gen:check": "bun tools/docgen/generate.ts && git diff --quiet -- docs/src/core/examples docs/src/core/registry.ts docs/src/core/raw-md.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=14",
    "react-native-qrcode-svg": ">=6",
    "react-native-safe-area-context": ">=4",
    "expo-blur": "*",
    "expo-glass-effect": "*"
  },
  "peerDependenciesMeta": {
    "react-native-qrcode-svg": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "expo-blur": "~56.0.3",
    "expo-glass-effect": "~56.0.4",
    "happy-dom": "^20.10.6",
    "lucide-static": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "^0.85.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "^15",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "^19.2.7",
    "typescript": "^5.8.3"
  }
}
