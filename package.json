{
  "name": "@olympusoss/canvas",
  "version": "6.7.0",
  "type": "module",
  "description": "Universal React Native UI kit styled with Tailwind",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./styles/*"
  },
  "files": [
    "src",
    "styles",
    "package.json",
    "tsconfig.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate-tokens": "bun scripts/validate-tokens.ts",
    "check-size": "bun scripts/check-size.ts",
    "check-duplicates": "bun scripts/check-duplicates.ts",
    "screenshots": "bun scripts/capture-screenshots.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "docs:gen": "bun tools/docgen/generate.ts",
    "docs:gen:check": "bun tools/docgen/generate.ts && git diff --quiet -- docs/src/core/examples docs/src/core/registry.ts docs/src/core/raw-md.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "react-native-qrcode-svg": "^6.3.21"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=14",
    "expo-blur": "*",
    "expo-glass-effect": "*"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.16",
    "expo-blur": "~56.0.3",
    "expo-glass-effect": "~56.0.4",
    "react": "^19.2.7",
    "react-native": "^0.85.3",
    "react-native-svg": "^15",
    "typescript": "^5.8.3"
  }
}
