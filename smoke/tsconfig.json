{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@nannier/canvas": [
        "./node_modules/@nannier/canvas"
      ],
      "@nannier/canvas/*": [
        "./node_modules/@nannier/canvas/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
