node_modules/
dist/
.DS_Store
*.tsbuildinfo
.env*
coverage/

# Test screenshots are temporary, including visual reference images. Keep only
# non-reversible pixel digests and text measurements in Git; never image archives.
**/__screenshots__/
e2e/**/*.png
e2e/**/*.jpg
e2e/**/*.jpeg
e2e/**/*.webp
e2e/**/*.gif
test/**/*.png
test/**/*.jpg
test/**/*.jpeg
test/**/*.webp
test/**/*.gif
test/screenshots/
tools/native/reference/**/*.png
tools/native/reference/**/*.jpg
tools/native/reference/**/*.jpeg
tools/native/reference/**/*.webp
tools/native/reference/**/*.gif
tools/native/reference/**/*.mp4
tools/native/reference/**/*.webm
tools/native/reference/**/*.zip
tools/native/reference/**/*.tar*
tools/native/reference/**/*.tgz
tools/audit/fixtures/**/*.png
tools/audit/fixtures/**/*.jpg
tools/audit/fixtures/**/*.jpeg
tools/audit/fixtures/**/*.webp
tools/audit/fixtures/**/*.gif
tools/audit/fixtures/**/*.zip
tools/audit/fixtures/**/*.tar*
tools/audit/fixtures/**/*.tgz
**/*-actual.png
**/*-expected.png
**/*-diff.png

# Playwright reports and traces can embed screenshots, so ignore whole outputs.
playwright-report/
test-results/
blob-report/

# lookout's per-checkout state: screenshots, the judge's verdict cache, the
# backlog and its issue folders. All of it is regenerable, all of it is local,
# and lookout appends this exact line itself if it is missing, so committing
# anything under here does not survive the next run. What IS committed is the
# pair at the repository root, lookout.config.ts and lookout.rubric.md, which is
# where lookout looks for them.
.lookout/

# The component audit's captures: runs of screenshots, probes and analysis under
# .audit/runs/ and the contact sheets and index under .audit/current/. Regenerable
# and large (a full run is tens of GB), so none of it is committed. What IS committed
# is audit/ at the repository root: the per-component checklists and the README.
.audit/

# Generated plugin submission bundles and local package inputs.
.artifacts/

# Local Claude Code session state
.claude/

# Generated at pack time by tools/licensegen: the MIT grant covers the PUBLISHED
# package only. Committing it here would make GitHub read the whole repository as
# MIT, which is the opposite of the intent (source stays all rights reserved).
LICENSE

# Native capture module build products stay local.
android/build/
android/.gradle/
android/.cxx/

# Reference images photographed from the vendored v4 hand-off (tools/v4/capture-references.ts).
.v4-reference/

# design-sync (Claude Design import): staged converter, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
