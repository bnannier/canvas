{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "../docs/src/*"
      ],
      "react-router-dom": [
        "./src/web/react-router-shim.tsx"
      ],
      "@olympusoss/canvas": [
        "../src/index.ts"
      ],
      "docs-core/*": [
        "../docs-core/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "types/**/*.d.ts"
  ]
}
