{
  "expo": {
    "name": "Canvas",
    "slug": "canvas-docs",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "canvas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.olympusoss.canvasdocs",
      "supportsTablet": true
    },
    "android": {
      "package": "com.olympusoss.canvasdocs"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
